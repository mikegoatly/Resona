<UserControl
    x:Class="Resona.UI.Views.AudioSelectionView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="using:Resona.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Resona.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Resona.UI.ViewModels"
    x:Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:AudioSelectionViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <con:AudioKindImageConverter x:Key="audioKindImageConverter" />
    </UserControl.Resources>
    <Design.DataContext>
        <vm:AudioSelectionViewModel />
    </Design.DataContext>
    <!-- DownOnly: content keeps its designed size (1024x600) and only shrinks when the space is smaller, e.g. a phone -->
    <Viewbox
        Margin="0,10"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Stretch="Uniform"
        StretchDirection="DownOnly">
    <ItemsControl ItemsSource="{Binding AudioKinds}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AudioKindInfo">

                <Button
                    Margin="0,0,5,0"
                    Background="#4999"
                    Command="{ReflectionBinding ViewModel.AudioKindSelected,
                                                ElementName=Root}"
                    CommandParameter="{Binding Kind}"
                    CornerRadius="200">
                    <Image
                        Width="280"
                        Height="280"
                        Margin="20"
                        Source="{Binding Kind, Converter={StaticResource audioKindImageConverter}}">
                        <!-- Scale via RenderTransform rather than animating Width/Height/Margin, which re-runs
                             layout every frame. The transition eases both ways, so release springs back. -->
                        <Image.Styles>
                            <Style Selector="Button > Image">
                                <Setter Property="RenderTransform" Value="scale(1)" />
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="BackEaseOut" />
                                    </Transitions>
                                </Setter>
                            </Style>
                            <Style Selector="Button:pointerover > Image">
                                <Setter Property="RenderTransform" Value="scale(1.1)" />
                            </Style>
                            <Style Selector="Button:pressed > Image">
                                <Setter Property="RenderTransform" Value="scale(0.9)" />
                            </Style>
                        </Image.Styles>
                    </Image>
                    <Button.Styles>
                        <!-- Fluent's own pressed scale would shrink the circle too; keep the button still -->
                        <Style Selector="Button:pressed">
                            <Setter Property="RenderTransform" Value="none" />
                        </Style>
                        <Style Selector="Button /template/ ContentPresenter">
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#4DDD" />
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="#4DDD" />
                        </Style>
                    </Button.Styles>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Viewbox>
</UserControl>
